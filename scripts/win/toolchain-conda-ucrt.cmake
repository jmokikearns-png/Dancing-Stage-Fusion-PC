# Linux -> Windows x86_64 cross toolchain: conda-forge GCC 16 (UCRT, mingw-w64 12,
# posix threads). The Windows-hosted build of the same compiler and sysroot
# ships with the player setup, so objects built here link there.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(MINGW_TRIPLE "x86_64-w64-mingw32" CACHE STRING "MinGW target triple")
set(DSF_TC "$ENV{DSF_TC}")
if(NOT DSF_TC)
  set(DSF_TC "/home/user/work/tc/linux")
endif()
set(CMAKE_C_COMPILER   "${DSF_TC}/bin/${MINGW_TRIPLE}-gcc")
set(CMAKE_CXX_COMPILER "${DSF_TC}/bin/${MINGW_TRIPLE}-g++")
set(CMAKE_RC_COMPILER  "${DSF_TC}/bin/${MINGW_TRIPLE}-windres")
set(CMAKE_RANLIB       "${DSF_TC}/bin/${MINGW_TRIPLE}-ranlib")
set(CMAKE_AR           "${DSF_TC}/bin/${MINGW_TRIPLE}-ar")
set(CMAKE_STRIP        "${DSF_TC}/bin/${MINGW_TRIPLE}-strip")
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${DSF_TC}/${MINGW_TRIPLE}/sysroot/usr/lib/pkgconfig")
set(CMAKE_FIND_ROOT_PATH "${DSF_TC}/${MINGW_TRIPLE}/sysroot/usr")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
string(APPEND CMAKE_C_FLAGS_INIT " -Wa,-mbig-obj")
string(APPEND CMAKE_CXX_FLAGS_INIT " -Wa,-mbig-obj")
