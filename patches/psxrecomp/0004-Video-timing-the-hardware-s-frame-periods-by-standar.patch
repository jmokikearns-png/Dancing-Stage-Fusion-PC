@@ -1,22 +1,32 @@
 #ifndef PSXRECOMP_PSX_VIDEO_TIMING_H
 #define PSXRECOMP_PSX_VIDEO_TIMING_H
 
-/* Frame timing follows the GPU's live video standard.
+/* Frame timing follows the GPU's live video mode.
  *
- * On hardware the scanline count per frame (NTSC 263 / PAL 314) and so the
- * VBlank rate come from GP1(08h) bit 3, whatever the console or disc region.
- * The GPU reports every change of that bit here (GP1(08h), GP1(00h) reset,
- * power-on, snapshot restore); VBlank scheduling (interrupts.c), the Timer 1
- * HBlank clock (timers.c) and host frame pacing (main.cpp) all read it.
+ * On hardware the frame (field) period comes from GP1(08h): bit 3 selects
+ * the NTSC or PAL video clock and line count, bit 5 interlace, whatever the
+ * console or disc region.  The GPU reports every change of those bits here
+ * (GP1(08h), GP1(00h) reset, power-on, snapshot restore); VBlank scheduling
+ * (interrupts.c), the Timer 1 HBlank clock (timers.c) and host frame pacing
+ * (main.cpp) all read it.
  *
- * The frame period is live: the frame in progress ends once its elapsed
- * cycles reach the CURRENT standard's period, the way a scanline counter
- * running against the new line total would end the field. From the next
- * frame on the period is exactly the new standard's. No extra state is
- * needed across savestates: the GPU snapshot carries the mode bit.
+ * The periods are the hardware's, as mednafen's PSX GPU (psx/gpu.cpp, the
+ * reference) runs them: CPU 33.8688 MHz (44100 * 768); video clock NTSC
+ * 53.693182 MHz (315/88 * 15), PAL 53.203425 MHz; a scanline is 3412.5
+ * video clocks NTSC (3412 and 3413 alternating) and 3405 PAL; a frame is
+ * 263 / 314 lines progressive, 262.5 / 312.5 lines per field interlaced
+ * (fields alternate one line longer and shorter).  In CPU cycles, rounded:
+ *   NTSC progressive 566120.76 (59.826 Hz), interlaced 565044.48 (59.940 Hz)
+ *   PAL  progressive 680623.57 (49.761 Hz), interlaced 677372.18 (50.000 Hz)
+ *   line NTSC 2152.55, PAL 2167.59
+ * Games time themselves by these: Dancing Stage Fusion (PAL, progressive)
+ * advances its song clock 15072 / 750000 s (20.096 ms) per VBlank.
  *
- * The periods keep the framework's round 60/50 Hz constants so NTSC timing
- * is bit-identical to the region-only model this replaces. */
+ * The frame period is live: the frame in progress ends once its elapsed
+ * cycles reach the CURRENT mode's period, the way a scanline counter running
+ * against the new line total would end the field.  From the next frame on
+ * the period is exactly the new mode's.  No extra state is needed across
+ * savestates: the GPU snapshot carries the mode bits. */
 
 #include <stdint.h>
 
@@ -24,17 +34,20 @@
 extern "C" {
 #endif
 
-#define PSX_VBLANK_CYCLES_NTSC   564480u  /* 33.8688 MHz / 60 Hz */
-#define PSX_VBLANK_CYCLES_PAL    677376u  /* 33.8688 MHz / 50 Hz */
+#define PSX_VBLANK_CYCLES_NTSC   566121u  /* progressive, 59.826 Hz */
+#define PSX_VBLANK_CYCLES_NTSC_I 565044u  /* interlaced field, 59.940 Hz */
+#define PSX_VBLANK_CYCLES_PAL    680624u  /* progressive, 49.761 Hz */
+#define PSX_VBLANK_CYCLES_PAL_I  677372u  /* interlaced field, 50.000 Hz */
 #define PSX_LINES_PER_FRAME_NTSC 263u
 #define PSX_LINES_PER_FRAME_PAL  314u
-/* Timer 1 HBlank clock: one frame's cycles spread over its scanlines,
- * truncated (NTSC 564480 / 263 = 2146, PAL 677376 / 314 = 2157). */
-#define PSX_HBLANK_CYCLES_NTSC   (PSX_VBLANK_CYCLES_NTSC / PSX_LINES_PER_FRAME_NTSC)
-#define PSX_HBLANK_CYCLES_PAL    (PSX_VBLANK_CYCLES_PAL / PSX_LINES_PER_FRAME_PAL)
+/* Timer 1 HBlank clock: one scanline, rounded (2152.55 / 2167.59). */
+#define PSX_HBLANK_CYCLES_NTSC   2153u
+#define PSX_HBLANK_CYCLES_PAL    2168u
+/* CPU cycles per second, for host pacing (period_ms = cycles * 1000 / this). */
+#define PSX_CPU_CLOCK_HZ         33868800u
 
-/* Live values for the current standard. Written only through
- * psx_video_timing_set_pal(); read on hot paths. */
+/* Live values for the current mode. Written only through
+ * psx_video_timing_set_mode(); read on hot paths. */
 extern uint32_t g_psx_vblank_cycles;
 extern uint32_t g_psx_hblank_cycles;
 extern uint32_t g_psx_lines_per_frame;
@@ -44,8 +57,13 @@ static inline int psx_gp1_display_mode_is_pal(uint32_t word) {
     return (int)((word >> 3) & 1u);
 }
 
-/* Select the video standard. Returns 1 when it changed. */
-int      psx_video_timing_set_pal(int pal);
+/* GP1(08h) display-mode word -> 1 when bit 5 selects interlace. */
+static inline int psx_gp1_display_mode_is_interlaced(uint32_t word) {
+    return (int)((word >> 5) & 1u);
+}
+
+/* Select the video standard and interlace. Returns 1 when the period changed. */
+int      psx_video_timing_set_mode(int pal, int interlaced);
 int      psx_video_timing_is_pal(void);
 /* Bumped on every change; host-side observers (pacing) compare it. */
