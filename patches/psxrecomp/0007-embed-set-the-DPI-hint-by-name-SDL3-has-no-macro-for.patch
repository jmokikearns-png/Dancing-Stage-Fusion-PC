From 8ec50abf5747dd28551a5759474c550881c69382 Mon Sep 17 00:00:00 2001
From: DSF PC Port <jmokikearns@gmail.com>
Date: Sun, 25 Oct 2026 01:30:36 +0000
Subject: [PATCH 07/11] embed: set the DPI hint by name (SDL3 has no macro for
 it)

---
 runtime/src/main.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
index 0b845850..9b319bde 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -19199,12 +19199,13 @@ session_reboot:
         /* VIDEO only: no audio device, game-controller enumeration or host
          * input sampling. Keep sdl_window null so adaptive sizing and hotkeys
          * cannot use this invisible validation surface as a player window. */
-#if defined(PSX_EMBED) && defined(SDL_HINT_WINDOWS_DPI_AWARENESS)
+#if defined(PSX_EMBED) && defined(_WIN32)
         /* The host owns the process's window and its DPI awareness. SDL's
          * default (per-monitor v2) would make a DPI-unaware host's window
          * stop being scaled by Windows the moment the core starts, so it
-         * would shrink on a scaled display. Keep the host's (unaware). */
-        SDL_SetHint(SDL_HINT_WINDOWS_DPI_AWARENESS, "unaware");
+         * would shrink on a scaled display. Keep the host's (unaware).
+         * SDL3 reads the hint by name and has no macro for it. */
+        SDL_SetHint("SDL_WINDOWS_DPI_AWARENESS", "unaware");
 #endif
         if (SDL_Init(SDL_INIT_VIDEO) != 0) {
             std::fprintf(stderr, "psxrecomp: hidden OpenGL SDL init failed: %s\n", SDL_GetError());
