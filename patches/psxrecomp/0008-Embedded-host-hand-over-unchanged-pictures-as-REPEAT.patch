From 0c842e9f47eed9660a0e7c9650bf6b97cb44b220 Mon Sep 17 00:00:00 2001
From: DSF PC Port <jmokikearns@gmail.com>
Date: Fri, 30 Oct 2026 17:33:18 +0000
Subject: [PATCH 08/11] Embedded host: hand over unchanged pictures as REPEAT,
 no readback

The game draws every second VBlank; on the VBlank between, nothing the
display shows was written (rows marked at GP0 draws, fills and VRAM
transfers), so embed_vblank skips the readback and conversion.
---
 runtime/include/gpu.h       |  3 +++
 runtime/include/psx_embed.h |  1 +
 runtime/src/gpu.c           | 35 +++++++++++++++++++++++++++++++++++
 runtime/src/main.cpp        | 21 +++++++++++++++++++++
 4 files changed, 60 insertions(+)

diff --git a/runtime/include/gpu.h b/runtime/include/gpu.h
index b2821fcd..57906bf3 100644
--- a/runtime/include/gpu.h
+++ b/runtime/include/gpu.h
@@ -46,6 +46,9 @@ typedef struct {
 } GpuDisplayInfo;
 
 void gpu_get_display_info(GpuDisplayInfo* out);
+/* Nonzero when a GP0 command may have written a VRAM row in [y, y + h)
+ * since the last call; every call forgets all rows. */
+int gpu_written_rows_take(uint32_t y, uint32_t h);
 /* Render-pass GPU register checkpoint (render_pass.c). One at a time. */
 int gpu_pass_checkpoint_save(void);
 void gpu_pass_checkpoint_restore(void);
diff --git a/runtime/include/psx_embed.h b/runtime/include/psx_embed.h
index ae40b16a..714fa3c5 100644
--- a/runtime/include/psx_embed.h
+++ b/runtime/include/psx_embed.h
@@ -19,6 +19,7 @@ extern "C" {
 enum {
     PSX_EMBED_FRAME_BLANK = 1,   /* display disabled or zero-sized: show black */
     PSX_EMBED_FRAME_24BIT = 2,   /* 24-bit (FMV) scanout, always native size */
+    PSX_EMBED_FRAME_REPEAT = 4,  /* the picture handed last time, unchanged: no pixels */
 };
 
 /* Displayed frame, 0xAARRGGBB, row pitch in pixels.  Core thread. */
diff --git a/runtime/src/gpu.c b/runtime/src/gpu.c
index 7d930665..624127d1 100644
--- a/runtime/src/gpu.c
+++ b/runtime/src/gpu.c
@@ -7161,7 +7161,42 @@ static void gp0_execute_command(void) {
     }
 }
 
+/* VRAM rows a GP0 command may have written since the last
+ * gpu_written_rows_take(): the embedded presenter hands the host no pixels
+ * for a VBlank whose displayed rows nothing wrote (main.cpp embed_vblank).
+ * Primitives count their whole draw area; fills, copies and uploads their
+ * destination. */
+static uint64_t s_written_rows[512 / 64];
+
+static void written_rows_mark(uint32_t y, uint32_t h) {
+    if (h == 0u || h > 512u) h = 512u;
+    for (uint32_t i = 0; i < h; i++) {
+        const uint32_t r = (y + i) & 511u;
+        s_written_rows[r >> 6] |= (uint64_t)1u << (r & 63u);
+    }
+}
+
+int gpu_written_rows_take(uint32_t y, uint32_t h) {
+    int any = 0;
+    if (h == 0u || h > 512u) h = 512u;
+    for (uint32_t i = 0; i < h && !any; i++) {
+        const uint32_t r = (y + i) & 511u;
+        any = (s_written_rows[r >> 6] >> (r & 63u)) & 1u;
+    }
+    memset(s_written_rows, 0, sizeof s_written_rows);
+    return any;
+}
+
 static void gp0_dispatch_command(uint8_t opcode) {
+    if (opcode == 0x02)
+        written_rows_mark((gp0_cmd_buf[1] >> 16) & 511u, (gp0_cmd_buf[2] >> 16) & 511u);
+    else if (opcode >= 0x20 && opcode < 0x80)
+        written_rows_mark(draw_area_top, draw_area_bottom >= draw_area_top
+                          ? draw_area_bottom - draw_area_top + 1u : 512u);
+    else if (opcode >= 0x80 && opcode < 0xA0)
+        written_rows_mark((gp0_cmd_buf[2] >> 16) & 511u, (gp0_cmd_buf[3] >> 16) & 511u);
+    else if (opcode >= 0xA0 && opcode < 0xC0)
+        written_rows_mark((gp0_cmd_buf[1] >> 16) & 511u, (gp0_cmd_buf[2] >> 16) & 511u);
     switch (opcode) {
         case 0x00:
         case 0x01:
diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
index 9b319bde..03f36211 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -8335,6 +8335,11 @@ static bool local_mouse_live(int override_word) {
  * go-ahead, and apply the host's pads for the next frame. */
 static void embed_vblank(void) {
     static std::vector<uint32_t> buf;
+    /* The last readout handed over: a VBlank showing the same display with
+     * no VRAM row of it written since (the game draws every other VBlank)
+     * hands the host no pixels to read back, convert and upload again. */
+    static GpuDisplayInfo s_last_di;
+    static int s_last_scale = 0, s_last_valid = 0;
     static bool pads_connected = false;
     if (!pads_connected) {
         sio_set_pad_connected(0, 1);
@@ -8344,11 +8349,15 @@ static void embed_vblank(void) {
     GpuDisplayInfo di;
     gpu_get_display_info(&di);
     int w = 0, h = 0, scale = 1, flags = 0;
+    const int rows_written = gpu_written_rows_take(di.display_y, di.height);
+    int was_pass = 0;
     if (di.disabled || di.width == 0 || di.height == 0) {
         flags = PSX_EMBED_FRAME_BLANK;
         (void)render_pass_embed_present(-1, -1, 0, 0, 1);
+        s_last_valid = 0;
     } else if (di.depth24) {
         (void)render_pass_embed_present(-1, -1, 0, 0, 1);
+        s_last_valid = 0;
         w = (int)di.width;
         h = (int)di.screen_height;
         if (h <= 0) h = (int)di.height;
@@ -8363,8 +8372,13 @@ static void embed_vblank(void) {
         buf.resize((size_t)w * (size_t)h);
         const uint32_t *pass = render_pass_embed_present((int)di.display_x, (int)di.display_y,
                                                          (int)di.width, (int)di.height, scale);
+        const int same = s_last_valid && !rows_written && scale == s_last_scale &&
+                         std::memcmp(&di, &s_last_di, sizeof di) == 0;
         if (pass) {
             std::memcpy(buf.data(), pass, (size_t)w * (size_t)h * sizeof(uint32_t));
+            was_pass = 1;
+        } else if (same) {
+            flags = PSX_EMBED_FRAME_REPEAT;
         } else if (g_headless_opengl && g_gl_active) {
             /* The internal resolution lives in the GL FBO; the generic
              * readout is native there. */
@@ -8382,6 +8396,13 @@ static void embed_vblank(void) {
                     buf[(size_t)y * w + x] = gpu_display_pixel_argb(&di, (uint32_t)x, (uint32_t)y);
         }
     }
+    if (!di.disabled && di.width && di.height && !di.depth24) {
+        /* A pass image is not the display's own: the next VBlank reads it out. */
+        s_last_valid = !(flags & PSX_EMBED_FRAME_BLANK) && buf.size() == (size_t)w * (size_t)h &&
+                       !was_pass;
+        s_last_di = di;
+        s_last_scale = scale;
+    }
     psx_embed_video(buf.empty() ? nullptr : buf.data(), w, h, w, scale, flags);
     uint16_t pads[2] = {0xFFFFu, 0xFFFFu};
     psx_embed_frame_done(pads);
-- 
