+#endif
     if (!host_queue_ok || !sdl_audio_device)
         return;
 
@@ -8309,6 +8320,54 @@ static bool local_mouse_live(int override_word) {
     return pad_ext_live(&g) != 0;
 }
 
+#if defined(PSX_EMBED)
+/* Embedded VBlank: give the host the displayed frame (software renderer,
+ * hi-res mirror at the internal scale), wait for the host's go-ahead, and
+ * apply the host's pads for the next frame. */
+static void embed_vblank(void) {
+    static std::vector<uint32_t> buf;
+    static bool pads_connected = false;
+    if (!pads_connected) {
+        sio_set_pad_connected(0, 1);
+        sio_set_pad_connected(1, 1);
+        pads_connected = true;
+    }
+    GpuDisplayInfo di;
+    gpu_get_display_info(&di);
+    int w = 0, h = 0, scale = 1, flags = 0;
+    if (di.disabled || di.width == 0 || di.height == 0) {
+        flags = PSX_EMBED_FRAME_BLANK;
+    } else if (di.depth24) {
+        w = (int)di.width;
+        h = (int)di.screen_height;
+        if (h <= 0) h = (int)di.height;
+        buf.resize((size_t)w * (size_t)h);
+        depth24_stage_scanout(&di, buf.data(), (uint32_t)w);
+        flags = PSX_EMBED_FRAME_24BIT;
+    } else {
+        scale = gr_scale();
+        if (scale < 1) scale = 1;
+        w = (int)di.width * scale;
+        h = (int)di.height * scale;
+        buf.resize((size_t)w * (size_t)h);
+        if (scale > 1) {
+            gr_render_display_hires(buf.data(), w * (int)sizeof(uint32_t),
+                                    (int)di.display_x, (int)di.display_y,
+                                    (int)di.width, (int)di.height);
+        } else {
+            for (int y = 0; y < h; y++)
+                for (int x = 0; x < w; x++)
+                    buf[(size_t)y * w + x] = gpu_display_pixel_argb(&di, (uint32_t)x, (uint32_t)y);
+        }
+    }
+    psx_embed_video(buf.empty() ? nullptr : buf.data(), w, h, w, scale, flags);
+    uint16_t pads[2] = {0xFFFFu, 0xFFFFu};
+    psx_embed_frame_done(pads);
+    sio_set_pad_state_slot(0, pads[0]);
+    sio_set_pad_state_slot(1, pads[1]);
+}
+#endif
+
 static NetplayVblankEpilogue sdl_vblank_present_body(void) {
     NetplayVblankEpilogue ep{};
     /* Guest quantum for this vblank is complete. Drop top-level-resume armed
@@ -8690,6 +8749,9 @@ static NetplayVblankEpilogue sdl_vblank_present_body(void) {
     if (g_headless) {
 #ifndef PSX_NO_DEBUG_TOOLS
         headless_present_image_ring_capture();
+#endif
+#if defined(PSX_EMBED)
+        embed_vblank();
 #endif
         ep.skip_pace = 1;
         return ep;
@@ -15873,7 +15935,12 @@ static uint32_t gcs_gate_read_ram(uint32_t phys, uint32_t size) {
     return v;
 }
 
+#if defined(PSX_EMBED)
+/* The host program calls this on a thread with a 64 MiB stack. */
+extern "C" int psx_embed_runtime_main(int argc, char** argv) {
+#else
 int main(int argc, char** argv) {
+#endif
     /* Force line-buffered output so messages appear even if killed. */
     std::setvbuf(stdout, nullptr, _IOLBF, BUFSIZ);
     std::setvbuf(stderr, nullptr, _IOLBF, BUFSIZ);
@@ -15919,7 +15986,9 @@ int main(int argc, char** argv) {
 
     /* Install crash handlers early so they catch issues during init too.
      * Writes psx_last_run_report.json on signal/SEH/atexit/fail-fast. */
+#if !defined(PSX_EMBED)   /* the host program has its own crash handler */
     psx_crash_trace_install_handlers();
+#endif
 #if defined(RECOMP_LAUNCHER)
     launcher_boot_timing_mark("host:crash_handlers");
 #endif
@@ -16076,6 +16145,11 @@ int main(int argc, char** argv) {
             }
         }
     }
+#if defined(PSX_EMBED)
+    /* No window, audio device or input of our own: the host provides them. */
+    g_headless = 1;
+    force_no_launcher = true;
+#endif
     if (const char *e = std::getenv("PSX_HEADLESS")) {
         if (e[0] && e[0] != '0') {
             g_headless = 1;
@@ -19067,8 +19141,11 @@ session_reboot:
 #ifdef PSX_COSIM
         cosim_init();  /* first-divergence oracle server */
 #endif
-        /* Heartbeat always on — see freeze_heartbeat.c rationale. */
+        /* Heartbeat always on — see freeze_heartbeat.c rationale.  Not when
+         * embedded: the host parks the guest whenever its menus are open. */
+#if !defined(PSX_EMBED)
         freeze_heartbeat_start("psx-runtime");
+#endif
     } else {
 #ifndef PSX_NO_DEBUG_TOOLS
         (void)debug_port;
