+#endif
 #include "psx_sdl_audio.h"
 #if defined(PSX_WEB)
 #include <emscripten/emscripten.h>
@@ -4129,6 +4135,11 @@ static void sdl_audio_pump(bool discard_output = false) {
     }
     if (discard_output)
