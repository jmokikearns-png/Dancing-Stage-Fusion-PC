From caf4c91f449fd28d81e3ed09767989f1d49a44fe Mon Sep 17 00:00:00 2001
From: DSF PC Port <jmokikearns@gmail.com>
Date: Fri, 16 Oct 2026 20:53:31 +0000
Subject: [PATCH 01/11] Embedded mode (PSX_EMBED): run as a shared library
 driven by a host program

Headless runtime on a host-created thread; at each VBlank the displayed
frame goes to the host, which then releases the next frame and supplies the
pads; SPU output goes to the host instead of an SDL device.  No crash
handlers or freeze heartbeat of our own in this mode.
---
 runtime/include/psx_embed.h | 37 +++++++++++++++++
 runtime/runtime.cmake       | 14 +++++++
 runtime/src/main.cpp        | 79 ++++++++++++++++++++++++++++++++++++-
 3 files changed, 129 insertions(+), 1 deletion(-)
 create mode 100644 runtime/include/psx_embed.h

diff --git a/runtime/include/psx_embed.h b/runtime/include/psx_embed.h
new file mode 100644
index 00000000..ae40b16a
--- /dev/null
+++ b/runtime/include/psx_embed.h
@@ -0,0 +1,37 @@
+/* psx_embed.h -- run the runtime inside another program (PSX_EMBED builds).
+ *
+ * The host owns the window, sound output, input and pacing.  The runtime runs
+ * headless on its own thread; at every guest VBlank it hands the host the
+ * displayed frame, then waits until the host lets the next frame run and
+ * takes the pad words to use for it.  SPU output (44.1 kHz S16 stereo) is
+ * handed over as it is produced.  The functions below are implemented by the
+ * embedding layer, not by the runtime.
+ */
+#ifndef PSX_EMBED_H
+#define PSX_EMBED_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    PSX_EMBED_FRAME_BLANK = 1,   /* display disabled or zero-sized: show black */
+    PSX_EMBED_FRAME_24BIT = 2,   /* 24-bit (FMV) scanout, always native size */
+};
+
+/* Displayed frame, 0xAARRGGBB, row pitch in pixels.  Core thread. */
+void psx_embed_video(const uint32_t *argb, int width, int height, int pitch_px,
+                     int scale, int flags);
+/* SPU output.  Core thread. */
+void psx_embed_audio(const int16_t *stereo, int frames);
+/* Block until the host allows the next frame; fill the active-low pad words
+ * for ports 1 and 2.  Core thread. */
+void psx_embed_frame_done(uint16_t pads_out[2]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/runtime/runtime.cmake b/runtime/runtime.cmake
index fb0b1988..dd7f6bf3 100644
--- a/runtime/runtime.cmake
+++ b/runtime/runtime.cmake
@@ -1607,12 +1607,26 @@ function(psxrecomp_add_runtime_target target)
         set(mode_source ${PSXRECOMP_ROOT}/runtime/src/stub_interpreter.c)
     endif()
 
+    # PSX_EMBED: a shared library run by a host program (window, sound, input
+    # and pacing are the host's; see runtime/include/psx_embed.h). The host
+    # side of psx_embed.h must be added to the target by the game project.
+    option(PSX_EMBED "Build the runtime as a shared library driven by a host program" OFF)
+    if(PSX_EMBED)
+        add_library(${target} SHARED
+            ${PSXRECOMP_RUNTIME_SOURCES}
+            ${mode_source}
+            ${generated_sources}
+            ${PSXRT_EXTRAS_SOURCES}
+        )
+        target_compile_definitions(${target} PRIVATE PSX_EMBED=1)
+    else()
     add_executable(${target}
         ${PSXRECOMP_RUNTIME_SOURCES}
         ${mode_source}
         ${generated_sources}
         ${PSXRT_EXTRAS_SOURCES}
     )
+    endif()
     target_link_libraries(${target} PRIVATE chdr-static psx_texture_image_decode)
     psxrecomp_sha256_file(${target})
     set(_execution_contract
diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
index cf33df28..5c7f22b9 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -159,8 +159,14 @@ extern "C" void psx_game_codegen_forward_if_built(int argc, char** argv);
  * translation unit that defines main(); including it through psx_sdl.h makes
