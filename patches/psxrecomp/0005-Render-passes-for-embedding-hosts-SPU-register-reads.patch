+uint32_t gl_renderer_embed_pass_unavailable(void) {
+    GL_RT_SYNC("embed_pass_unavailable");
+    pass_refusal_init();
+    if (!s_ctx || !s_raster_ok || !s_hr_fbo || ctx_depth24())
+        return PSX_MOD_RENDER_PASS_NO_PRESENTER;
