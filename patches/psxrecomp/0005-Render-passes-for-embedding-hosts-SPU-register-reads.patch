+#ifndef PSX_RENDER_PASS_EMBED_H
+#define PSX_RENDER_PASS_EMBED_H
+
+/* Render passes presented by an embedding host (PSX_EMBED builds): the host
+ * is handed one image per VBlank (main.cpp embed_vblank), so a pass image
+ * replaces the live readout on the VBlank its phase falls on. No presenter of
+ * the runtime's own is involved. See docs/RENDER_PASSES.md, "Embedded hosts".
+ *
+ * render_pass.c routes the temporal pass (psx_mod_render_pass_plan /
+ * psx_mod_render_pass) here while render_pass_embed_enabled(); stereo and the
+ * netplay local view stay on the OpenGL presenter. */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* main.cpp, embedded mode: the host presents what embed_vblank hands it. */
+void render_pass_embed_enable(int on);
+int render_pass_embed_enabled(void);
+
+/* PSX_MOD_RENDER_PASS_* reason, renderer side (READY = passes can run). */
+uint32_t render_pass_embed_unavailable(void);
+/* Phases k / period_vblanks, k = 1 .. period_vblanks - 1 (at most max): the
+ * host shows every VBlank, so no phase is shed. shown_after_vblanks: see
+ * render_pass_embed_present(). */
+uint32_t render_pass_embed_plan(uint32_t period_vblanks, uint32_t shown_after_vblanks,
+                                uint32_t *alpha_q16, uint32_t max, uint32_t *wanted);
+/* The VRAM transaction: back up the rect (VRAM x, y, w, h), and at the end
+ * capture it into the frame's slot when keep, then restore everything the
+ * pass drew (the rect, and VRAM outside it). */
+int render_pass_embed_begin(int x, int y, int w, int h);
+int render_pass_embed_end(uint32_t alpha_q16, int keep);
+
+/* Each embedded VBlank, before its readout: the display shows VRAM rect
+ * (x, y, w, h) at `scale`. Returns the pass image to hand the host instead of
+ * the readout (w * scale by h * scale ARGB, pitch w * scale), or NULL.
+ *
+ * A frame's images wait from their plan for a flip of the display to their
+ * rect (another rect than the one shown before) at least the plan's
+ * shown_after_vblanks VBlanks later: the frame they belong to is on screen
+ * from there. Phase k is shown from the k-th VBlank after that flip, the
+ * last one also on the VBlank after the frame's period (a frame the game is
+ * late with) and never later. */
+const uint32_t *render_pass_embed_present(int x, int y, int w, int h, int scale);
+
+typedef struct RenderPassEmbedStats {
+    uint64_t captured;   /* pass images kept */
+    uint64_t shown;      /* VBlanks that handed the host a pass image */
+    uint64_t flips;      /* display flips seen */
+    uint64_t expired;    /* frames flipped to with no armed images */
+    uint64_t rebuilt_rows; /* hi-res mirror rows rebuilt after a pass wrote VRAM outside its rect */
+    uint64_t plan;         /* plans so far */
+    uint64_t shown_plan;   /* the plan of the last image shown */
+    int32_t  shown_y;      /* its rect's VRAM y */
+    int32_t  display_y;    /* the display's VRAM y at the last VBlank */
+    uint64_t vblanks;      /* VBlanks presented */
+} RenderPassEmbedStats;
+void render_pass_embed_get_stats(RenderPassEmbedStats *out);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
