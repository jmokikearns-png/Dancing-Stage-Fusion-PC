+        return PSX_MOD_RENDER_PASS_BACKEND;
+    return PSX_MOD_RENDER_PASS_READY;
+}
+int gl_renderer_embed_pass_begin(int x, int y, int w, int h) {
+    GL_RT_SYNC("embed_pass_begin");
+    return transaction_begin(x, y, w, h, 0, 0, 0, 3);
+}
+int gl_renderer_embed_pass_end(uint32_t *argb, int pitch, int keep) {
+    int n = 0;
+    GL_RT_SYNC("embed_pass_end");
+    if (!s_pass_active) return 0;
+    flush_flat_batch(); flush_tex_batch(); flush_cpu_upload();
+    if (keep && argb)
+        n = gl_renderer_capture_display_hires(argb, pitch, s_pass_x, s_pass_y,
+                                              s_pass_w, s_pass_h);
+    transaction_restore();
+    return n;
+}
