+/* render_pass_embed.c - render passes presented by an embedding host. See
+ * render_pass_embed.h and docs/RENDER_PASSES.md ("Embedded hosts").
+ *
+ * The host is handed one image per VBlank (main.cpp embed_vblank). A frame
+ * the game shows for P VBlanks gets P - 1 pass images; each is kept in the
+ * slot of the VRAM rect the frame is drawn in (double buffering alternates
+ * two) and shown on its VBlank once the display flips to that rect.
+ *
+ * The VRAM transaction is the OpenGL renderer's own when it draws
+ * (gl_renderer_embed_pass_begin/_end: rect backup, out-of-rect journal);
+ * with the software renderer it is here: canonical VRAM is backed up whole
+ * (1 MiB) and the rect of the supersampled mirror; afterwards any VRAM row
+ * the pass changed outside the rect is put back and its mirror row rebuilt
+ * from VRAM, as an upload would have left it. */
+
+#include "render_pass_embed.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "gpu.h"
+#include "gpu_gl_renderer.h"
+#include "gpu_render.h"
+#include "gpu_sw_renderer.h"
+#include "gpu_vram_dirty.h"
+#include "mod_plugins.h"
+
+extern uint16_t *gpu_get_vram_ptr(void);
+
+#define VRAM_W 1024
+#define VRAM_H 512
+#define RPE_SLOTS 4
+#define RPE_GENS 3
+#define RPE_MAX_PHASES 8
+
+/* One frame's images. */
+typedef struct EmbedGen {
+    uint64_t plan;       /* the plan whose frame the images show */
+    uint64_t vblank;     /* s_stats.vblanks when it was planned */
+    uint32_t period, shown_after;
+    int scale;
+    int armed;           /* waiting for its flip */
+    uint32_t mask;       /* phases captured: bit k */
+    uint32_t *img[RPE_MAX_PHASES];
+    size_t cap[RPE_MAX_PHASES];
+} EmbedGen;
+
+/* A VRAM rect frames are drawn in: the frame on screen there (live) and up
+ * to two waiting for later flips to it (a game may draw a frame's passes
+ * before the flip that shows the rect's previous frame). */
+typedef struct EmbedSlot {
+    int used, x, y, w, h;
+    uint64_t last_use;
+    int live;            /* gen index, or -1 */
+    EmbedGen gen[RPE_GENS];
+} EmbedSlot;
+
+static int s_enabled;
+static EmbedSlot s_slot[RPE_SLOTS];
+static uint64_t s_plan, s_use;
+static uint32_t s_plan_period = 1, s_plan_shown_after;
+static RenderPassEmbedStats s_stats;
+
+/* The open transaction. */
+static int s_open, s_gl, s_x, s_y, s_w, s_h;
+static uint16_t *s_vram_backup;
+static uint16_t *s_hr_backup;
+static size_t s_hr_backup_cap;
+
+/* The display last handed to the host. */
+static int s_cur_x = -1, s_cur_y = -1, s_cur_w, s_cur_h;
+static uint32_t s_since_flip;
+
+void render_pass_embed_enable(int on) { s_enabled = on ? 1 : 0; }
+int render_pass_embed_enabled(void) { return s_enabled; }
+
+void render_pass_embed_get_stats(RenderPassEmbedStats *out) {
+    s_stats.plan = s_plan;
+    if (out) *out = s_stats;
+}
+
+static int gl_draws(void) { return gr_backend() == GR_BACKEND_OPENGL; }
+
+uint32_t render_pass_embed_unavailable(void) {
+    if (!s_enabled) return PSX_MOD_RENDER_PASS_NO_PRESENTER;
+    if (gl_draws()) return gl_renderer_embed_pass_unavailable();
+    if (gpu_display_is_depth24()) return PSX_MOD_RENDER_PASS_NO_PRESENTER;
+    if (sw_renderer_wide_active()) return PSX_MOD_RENDER_PASS_BACKEND;
+    return PSX_MOD_RENDER_PASS_READY;
+}
+
+uint32_t render_pass_embed_plan(uint32_t period_vblanks, uint32_t shown_after_vblanks,
+                                uint32_t *alpha_q16, uint32_t max, uint32_t *wanted) {
+    uint32_t n = period_vblanks > 1u ? period_vblanks - 1u : 0u;
+    if (n > RPE_MAX_PHASES - 1u) n = RPE_MAX_PHASES - 1u;
+    if (wanted) *wanted = n;
+    if (n > max) n = max;
+    for (uint32_t k = 0; k < n; k++)
+        alpha_q16[k] = (uint32_t)(((uint64_t)(k + 1u) << 16) / period_vblanks);
+    s_plan++;
+    s_plan_period = period_vblanks;
+    s_plan_shown_after = shown_after_vblanks;
+    return n;
+}
+
+static EmbedSlot *slot_for(int x, int y, int w, int h, int make) {
+    EmbedSlot *lru = &s_slot[0];
+    for (int i = 0; i < RPE_SLOTS; i++) {
+        EmbedSlot *s = &s_slot[i];
+        if (s->used && s->x == x && s->y == y && s->w == w && s->h == h) return s;
+        if (!s->used || (lru->used && s->last_use < lru->last_use)) lru = s;
+    }
+    if (!make) return NULL;
+    lru->used = 1;
+    lru->x = x; lru->y = y; lru->w = w; lru->h = h;
+    lru->live = -1;
+    for (int i = 0; i < RPE_GENS; i++) {
+        lru->gen[i].plan = 0;
+        lru->gen[i].armed = 0;
+        lru->gen[i].mask = 0;
+    }
+    return lru;
+}
+
+int render_pass_embed_begin(int x, int y, int w, int h) {
+    if (s_open || x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > VRAM_W || y + h > VRAM_H)
+        return 0;
+    if (render_pass_embed_unavailable() != PSX_MOD_RENDER_PASS_READY) return 0;
+    s_gl = gl_draws();
+    if (s_gl) {
+        if (!gl_renderer_embed_pass_begin(x, y, w, h)) return 0;
+    } else {
+        int hw = 0, hh = 0;
+        const uint16_t *hr = sw_renderer_hires(&hw, &hh);
+        const uint16_t *vram = gpu_get_vram_ptr();
+        if (!s_vram_backup) {
+            s_vram_backup = (uint16_t *)malloc((size_t)VRAM_W * VRAM_H * sizeof(uint16_t));
+            if (!s_vram_backup) return 0;
+        }
+        memcpy(s_vram_backup, vram, (size_t)VRAM_W * VRAM_H * sizeof(uint16_t));
+        if (hr) {
+            const int sc = hw / VRAM_W;
+            const size_t rw = (size_t)w * sc, n = rw * (size_t)h * sc;
+            if (s_hr_backup_cap < n) {
+                uint16_t *p = (uint16_t *)realloc(s_hr_backup, n * sizeof(uint16_t));
+                if (!p) return 0;
+                s_hr_backup = p;
+                s_hr_backup_cap = n;
+            }
+            for (int r = 0; r < h * sc; r++)
+                memcpy(s_hr_backup + (size_t)r * rw,
+                       hr + (size_t)(y * sc + r) * hw + (size_t)x * sc, rw * sizeof(uint16_t));
+        }
+    }
+    s_open = 1;
+    s_x = x; s_y = y; s_w = w; s_h = h;
+    return 1;
+}
+
+/* Rebuild mirror row y, VRAM columns [x0, x1), from canonical VRAM. */
+static void hr_rebuild_span(uint16_t *hr, int hw, int sc, const uint16_t *vram, int y, int x0, int x1) {
+    for (int dy = 0; dy < sc; dy++) {
+        uint16_t *d = hr + (size_t)(y * sc + dy) * hw;
+        for (int x = x0; x < x1; x++) {
+            const uint16_t p = vram[(size_t)y * VRAM_W + x];
+            for (int dx = 0; dx < sc; dx++) d[x * sc + dx] = p;
+        }
+    }
+}
+
+/* Put VRAM row y's columns [x0, x1) back if the pass changed them. */
+static void sw_restore_span(uint16_t *vram, uint16_t *hr, int hw, int sc, int y, int x0, int x1) {
+    const size_t o = (size_t)y * VRAM_W;
+    if (x1 <= x0 || !memcmp(vram + o + x0, s_vram_backup + o + x0, (size_t)(x1 - x0) * sizeof(uint16_t)))
+        return;
+    memcpy(vram + o + x0, s_vram_backup + o + x0, (size_t)(x1 - x0) * sizeof(uint16_t));
+    if (hr) hr_rebuild_span(hr, hw, sc, vram, y, x0, x1);
+    gpu_vram_dirty_mark_row((uint32_t)y);
+    s_stats.rebuilt_rows++;
+}
+
+static void sw_restore(void) {
+    int hw = 0, hh = 0, sc = 1;
+    uint16_t *hr = sw_renderer_hires(&hw, &hh);
+    uint16_t *vram = gpu_get_vram_ptr();
+    if (hr) sc = hw / VRAM_W;
+    for (int y = 0; y < VRAM_H; y++) {
+        if (y >= s_y && y < s_y + s_h) {
+            sw_restore_span(vram, hr, hw, sc, y, 0, s_x);
+            sw_restore_span(vram, hr, hw, sc, y, s_x + s_w, VRAM_W);
+            memcpy(vram + (size_t)y * VRAM_W + s_x, s_vram_backup + (size_t)y * VRAM_W + s_x,
+                   (size_t)s_w * sizeof(uint16_t));
+        } else {
+            sw_restore_span(vram, hr, hw, sc, y, 0, VRAM_W);
+        }
+    }
+    if (hr) {
+        const size_t rw = (size_t)s_w * sc;
+        for (int r = 0; r < s_h * sc; r++)
+            memcpy(hr + (size_t)(s_y * sc + r) * hw + (size_t)s_x * sc,
+                   s_hr_backup + (size_t)r * rw, rw * sizeof(uint16_t));
+    }
+    gpu_vram_dirty_mark_rect(s_x, s_y, s_w, s_h);
+}
+
+/* The rect as embed_vblank reads the display out, at `scale`. */
+static int sw_capture(uint32_t *out, int scale) {
+    if (scale > 1)
+        return gr_render_display_hires(out, s_w * scale * (int)sizeof(uint32_t), s_x, s_y, s_w, s_h);
+    GpuDisplayInfo di;
+    gpu_get_display_info(&di);
+    di.display_x = (uint32_t)s_x;
+    di.display_y = (uint32_t)s_y;
+    di.width = (uint32_t)s_w;
+    di.height = (uint32_t)s_h;
+    for (int y = 0; y < s_h; y++)
+        for (int x = 0; x < s_w; x++)
+            out[(size_t)y * s_w + x] = gpu_display_pixel_argb(&di, (uint32_t)x, (uint32_t)y);
+    return s_w * s_h;
+}
+
+int render_pass_embed_end(uint32_t alpha_q16, int keep) {
+    EmbedSlot *slot = NULL;
+    EmbedGen *g = NULL;
+    uint32_t *img = NULL;
+    int ok = 0, k = 0;
+    const int scale = gr_scale() < 1 ? 1 : gr_scale();
+    if (!s_open) return 0;
+    if (keep && s_plan_period > 1u) {
+        k = (int)((((uint64_t)alpha_q16 * s_plan_period) + 32768u) >> 16);
+        if (k >= 1 && k < RPE_MAX_PHASES && (uint32_t)k < s_plan_period) {
+            slot = slot_for(s_x, s_y, s_w, s_h, 1);
+            for (int i = 0; i < RPE_GENS && !g; i++)
+                if (slot->gen[i].armed && slot->gen[i].plan == s_plan) g = &slot->gen[i];
+            if (!g) {
+                /* A free generation, else the oldest waiting one. */
+                for (int i = 0; i < RPE_GENS; i++) {
+                    EmbedGen *c = &slot->gen[i];
+                    if (i == slot->live) continue;
+                    if (!g || (g->armed && (!c->armed || c->vblank < g->vblank))) g = c;
+                }
+                g->plan = s_plan;
+                g->vblank = s_stats.vblanks;
+                g->period = s_plan_period;
+                g->shown_after = s_plan_shown_after;
+                g->scale = scale;
+                g->armed = 1;
+                g->mask = 0;
+            }
+            const size_t n = (size_t)s_w * scale * (size_t)s_h * scale;
+            if (g->cap[k] < n) {
+                uint32_t *p = (uint32_t *)realloc(g->img[k], n * sizeof(uint32_t));
+                if (p) { g->img[k] = p; g->cap[k] = n; }
+            }
+            if (g->cap[k] >= n && g->scale == scale) img = g->img[k];
+        }
+    }
+    if (s_gl) {
+        const int got = gl_renderer_embed_pass_end(img, s_w * scale * (int)sizeof(uint32_t), img != NULL);
+        ok = img && got == s_w * scale * s_h * scale;
+    } else {
+        if (img) ok = sw_capture(img, scale) == s_w * scale * s_h * scale;
+        sw_restore();
+    }
+    s_open = 0;
+    if (ok) {
+        g->mask |= 1u << k;
+        slot->last_use = ++s_use;
+        s_stats.captured++;
+    }
+    return keep ? ok : 1;
+}
+
+const uint32_t *render_pass_embed_present(int x, int y, int w, int h, int scale) {
+    EmbedSlot *slot;
+    s_stats.vblanks++;
+    s_stats.display_y = y;
+    if (x != s_cur_x || y != s_cur_y || w != s_cur_w || h != s_cur_h) {
+        s_cur_x = x; s_cur_y = y; s_cur_w = w; s_cur_h = h;
+        s_since_flip = 0;
+        s_stats.flips++;
+        for (int i = 0; i < RPE_SLOTS; i++) s_slot[i].live = -1;
+        slot = slot_for(x, y, w, h, 0);
+        if (slot) {
+            /* The newest frame due by now goes live; older ones are stale. */
+            int best = -1;
+            for (int i = 0; i < RPE_GENS; i++) {
+                const EmbedGen *c = &slot->gen[i];
+                if (c->armed && c->mask && s_stats.vblanks - c->vblank >= c->shown_after &&
+                    (best < 0 || c->vblank > slot->gen[best].vblank))
+                    best = i;
+            }
+            for (int i = 0; best >= 0 && i < RPE_GENS; i++)
+                if (slot->gen[i].armed && slot->gen[i].vblank <= slot->gen[best].vblank)
+                    slot->gen[i].armed = 0;
+            slot->live = best;
+            if (best < 0) s_stats.expired++;
+        }
+        return NULL;
+    }
+    s_since_flip++;
+    slot = slot_for(x, y, w, h, 0);
+    if (!slot || slot->live < 0) return NULL;
+    const EmbedGen *g = &slot->gen[slot->live];
+    if (g->scale != scale || s_since_flip > g->period) return NULL;
+    for (int k = (int)(s_since_flip < g->period ? s_since_flip : g->period - 1u); k >= 1; k--) {
+        if (g->mask & (1u << k)) {
+            s_stats.shown++;
+            s_stats.shown_plan = g->plan;
+            s_stats.shown_y = slot->y;
+            return g->img[k];
+        }
+    }
+    return NULL;
+}
